app "secretSecp" {
  meta { owl: 12; description: "Turn your Nostr nsec into a NIP-49 ncryptsec protected by a passphrase"; version: "1.0"; license: "MIT"; category: "security" }
  title: "secretSecp"
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="9" y="21" width="30" height="22" rx="4"/>
    <path d="M16 21v-6a8 8 0 0 1 16 0v6"/>
    <circle cx="24" cy="31" r="3"/>
    <path d="M24 34v5"/>
  </svg>"""

  state nsec = ""
  state npub = ""
  state pass = ""
  state pass2 = ""
  state logn = 16
  state ksb = 0
  state signInOut = ""
  state encOut = ""
  state pending = false
  state whoMsg = ""
  state encryptMsg = ""

  let signInCmd = "printf %s ${sh(toJson({ nsec: trim(nsec) }))} | node ~/.local/share/secretsecp/nip49.mjs npub || printf '{\"ok\":false,\"at\":%s,\"error\":\"could not run the key reader\"}' \"$(date +%s%N)\""
  let encryptCmd = "printf %s ${sh(toJson({ nsec: trim(nsec), pass: pass, logn: logn, ksb: ksb }))} | node ~/.local/share/secretsecp/nip49.mjs encrypt || printf '{\"ok\":false,\"at\":%s,\"error\":\"could not run the encryptor\"}' \"$(date +%s%N)\""

  let result = parseJson(encOut)
  let done = result != null && result.ok == true
  let failed = result != null && result.ok == false
  let memMiB = int(pow(2, logn) / 1024)
  let ksbText = ksb == 0 ? "This key was pasted or stored unencrypted, so it has been handled insecurely." : ksb == 1 ? "You have always kept this key encrypted." : "The client does not track how this key was handled."

  on signInOut {
    let d = parseJson(value)
    if d != null && d.ok == true {
      npub = d.npub
      whoMsg = ""
    } else {
      whoMsg = d != null ? (d.error ?? "couldn't read that key") : "couldn't read that key"
    }
  }

  on encOut {
    let d = parseJson(value)
    pending = false
    if d != null && d.ok == true { nsec = "" }
  }

  Column {
    scroll: true
    padding: [12, 0]
    gap: 14

    Column {
      gap: 4
      Text { text: "secretSecp"; style: title }
      Text { text: "Encrypt your Nostr private key with NIP-49. You get an ncryptsec that is safe to store or share; the nsec is used only here and never written down."; style: muted }
    }

    if done {
      Column {
        gap: 10
        padding: 14
        background: surface
        border: 1
        borderColor: border
        radius: 12 * corners

        Row {
          Text { text: "encrypted"; style: title; color: green; weight: 1 }
          Text { text: "new key"; style: small; color: accent; onTap: { nsec = ""; npub = ""; pass = ""; pass2 = ""; encOut = ""; whoMsg = ""; encryptMsg = ""; pending = false; ksb = 0; logn = 16 } }
        }

        Text { text: "signed in as"; style: label; color: muted }
        Text { text: result.npub; font: mono; style: small }

        Text { text: "ncryptsec"; style: label; color: muted }
        Text { text: result.ncryptsec; font: mono; style: small }

        Row {
          gap: 8
          Text { text: "copy"; padding: [14, 7]; background: accent; color: background; radius: 7 * corners; onTap: copy(result.ncryptsec) }
          Text { text: "share"; padding: [14, 7]; background: surface; border: 1; borderColor: border; radius: 7 * corners; onTap: share(result.ncryptsec) }
        }

        Text { text: "Keep the passphrase somewhere else, and remember that there is no way to recover it."; style: muted }
      }
    } else {
      Column {
        gap: 9
        padding: 14
        background: surface
        border: 1
        borderColor: border
        radius: 12 * corners

        Text { text: "logged in user"; style: label; color: muted }
        if npub == "" {
          Input { text: nsec; placeholder: "nsec1… or 64 hex"; password: true; focus: true; onChange: nsec = value }
          Text { text: "Paste the key you are logged in with. It stays on this phone."; style: small; color: muted }
          Button { text: "use this key"; onTap: {
            let key = trim(nsec)
            if key == "" {
              whoMsg = "paste your nsec first"
            } else if startsWith(key, "ncryptsec1") {
              whoMsg = "that is an ncryptsec, not an nsec"
            } else {
              whoMsg = ""
              signInOut = run(signInCmd)
            }
          } }
          if whoMsg != "" { Text { text: whoMsg; style: small; color: red } }
        } else {
          Text { text: npub; font: mono; style: small; color: green }
          Text { text: "change"; style: small; color: accent; onTap: { nsec = ""; npub = ""; whoMsg = "" } }
        }
      }

      if npub != "" {
        Column {
          gap: 9
          padding: 14
          background: surface
          border: 1
          borderColor: border
          radius: 12 * corners

          Text { text: "passphrase"; style: label; color: muted }
          Input { text: pass; placeholder: "a long passphrase"; password: true; onChange: pass = value }
          Input { text: pass2; placeholder: "repeat it"; password: true; onChange: pass2 = value }
          if pass != "" && pass2 != "" && pass != pass2 {
            Text { text: "the passphrases do not match"; style: small; color: red }
          }
          Text { text: "The ncryptsec can only be opened with this passphrase. It is not stored."; style: small; color: muted }
        }

        Column {
          gap: 8
          padding: 14
          background: surface
          border: 1
          borderColor: border
          radius: 12 * corners

          Row {
            Text { text: "work factor"; style: label; color: muted; weight: 1 }
            Text { text: "2^${logn} · ${memMiB} MiB"; style: small; font: mono }
          }
          Slider { value: logn; min: 12; max: 18; step: 1; onChange: logn = int(value) }
          Text { text: "Higher takes longer to crack, and longer to open."; style: small; color: muted }
        }

        Column {
          gap: 8
          padding: 14
          background: surface
          border: 1
          borderColor: border
          radius: 12 * corners

          Text { text: "how was this key handled?"; style: label; color: muted }
          Row {
            gap: 6
            Text { text: "pasted"; padding: [12, 6]; radius: 7 * corners; style: small; background: ksb == 0 ? accent : transparent; color: ksb == 0 ? background : foreground; border: 1; borderColor: border; onTap: ksb = 0 }
            Text { text: "always encrypted"; padding: [12, 6]; radius: 7 * corners; style: small; background: ksb == 1 ? accent : transparent; color: ksb == 1 ? background : foreground; border: 1; borderColor: border; onTap: ksb = 1 }
            Text { text: "unknown"; padding: [12, 6]; radius: 7 * corners; style: small; background: ksb == 2 ? accent : transparent; color: ksb == 2 ? background : foreground; border: 1; borderColor: border; onTap: ksb = 2 }
          }
          Text { text: ksbText; style: small; color: muted }
        }

        Button { text: pending ? "encrypting…" : "encrypt nsec"; onTap: {
          if !pending {
            if trim(nsec) == "" {
              encryptMsg = "paste your nsec again"
            } else if pass == "" {
              encryptMsg = "choose a passphrase"
            } else if pass != pass2 {
              encryptMsg = "the passphrases do not match"
            } else {
              encryptMsg = ""
              pending = true
              encOut = run(encryptCmd)
              pass = ""
              pass2 = ""
            }
          }
        } }

        if failed { Text { text: result.error ?? "couldn't encrypt"; style: small; color: red } }
        if encryptMsg != "" { Text { text: encryptMsg; style: small; color: red } }
      }
    }

    Text { text: "NIP-49 · scrypt + XChaCha20-Poly1305"; style: small; color: muted; align: center }
    Spacer { height: 8 }
  }
}
